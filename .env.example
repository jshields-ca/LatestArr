# Copy this file to .env (docker compose reads .env automatically) and
# fill in the values below before running `docker compose up`.

# Required. Encrypts source credentials, SMTP credentials, and the OIDC
# client secret at rest (AES-256-GCM). Generate one with:
#   openssl rand -base64 32
# Losing this key makes existing encrypted data unrecoverable, so back it
# up somewhere other than this file.
ENCRYPTION_KEY=

# Optional. The externally-reachable URL for this instance, used as the
# post-login redirect fallback when OIDC is enabled. Defaults to
# http://localhost:3000 if left blank.
WEB_ORIGIN=http://localhost:3000

# Optional. The HOST port docker-compose maps to the container (which
# always listens on 3000 internally) — change this if 3000 is already in
# use by something else on this machine. Defaults to 3000 if left blank.
# If you change this, update WEB_ORIGIN above to match.
PORT=3000

# Optional. Pin to a specific released version instead of always tracking
# the latest — e.g. LATESTARR_VERSION=v0.4.0. Defaults to "latest" (the
# most recent tagged release, not necessarily the newest main commit) if
# left blank. See ghcr.io/jshields-ca/latestarr for available tags.
LATESTARR_VERSION=latest

# Optional. Set to "true" only if this instance sits behind a reverse proxy
# that terminates TLS and forwards the original client IP/protocol via
# X-Forwarded-For/X-Forwarded-Proto (see "Running behind a reverse proxy" in
# docs/self-hosting.md) — needed for the session cookie's Secure flag and
# login rate-limiting to work correctly in that setup. Leave blank/false for
# direct http:// access (the default Getting Started flow above), or you'll
# be unable to log in.
TRUST_PROXY=

# Optional — OIDC/SSO (Authelia, Authentik, Keycloak, Auth0, etc.). Leave
# all four blank to use local username/password auth only (the default).
# All four are required together to enable SSO.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
# Space-separated scopes. Defaults to "openid profile email" if left blank.
OIDC_SCOPES=
