# Copy this file to .env (docker compose reads .env automatically) and
# fill in the values below before running `docker compose up`.
# docs/self-hosting.md explains each setting in more detail.

# Required. Encrypts the credentials LatestArr stores (source API keys and
# tokens, SMTP passwords, webhook URLs) with AES-256-GCM. Generate one with:
#   openssl rand -base64 32
# Backups don't include it, and without it those credentials can't be read,
# so keep a copy somewhere other than this file.
ENCRYPTION_KEY=

# Optional. The address people open LatestArr at, e.g. your reverse proxy's
# https:// address. Password reset links and SSO sign-ins use it, so it must
# match exactly, with no trailing slash. Defaults to http://localhost:3000.
WEB_ORIGIN=http://localhost:3000

# Optional. Where backups are saved inside the container. Defaults to
# /app/data/backups, on the same volume as the database, so mount another
# disk or a NAS share and point this at it to survive a failed disk.
# BACKUP_PATH=/backups

# Optional. The port on this machine that reaches LatestArr (the container
# always listens on 3000 inside). Change it if 3000 is already in use, and
# update WEB_ORIGIN to match. Defaults to 3000.
PORT=3000

# Optional. Your timezone, e.g. America/Winnipeg, so the daily backup runs
# at 3:00 AM your time. Defaults to UTC if left blank.
TZ=

# Optional. Pin a released version, e.g. v0.12.0, instead of the newest
# release. Defaults to "latest", the newest tagged release (not the newest
# commit). Tags are listed at ghcr.io/jshields-ca/latestarr.
LATESTARR_VERSION=latest

# Optional. Set to "true" only behind a reverse proxy that forwards the
# client's address and protocol (X-Forwarded-For, X-Forwarded-Proto). Then
# the session cookie is marked Secure, and sign-in limits see each person's
# own IP instead of the proxy's. Leave it blank with no proxy in front, or
# anyone could fake their IP and get round the sign-in limit. See "Running
# behind a reverse proxy" in docs/self-hosting.md.
TRUST_PROXY=

# Optional. How much the server logs, to `docker logs` and the Logs page:
# "info" (the default) records sends, sign-ins and settings changes,
# "debug" adds per-source item counts for each send, and "warn" keeps only
# problems.
LOG_LEVEL=

# Optional. SSO with any OIDC provider (Authelia, Authentik, Keycloak and
# others). Set all four to turn it on, or leave all four blank for password
# sign-in only. OIDC_REDIRECT_URI is <WEB_ORIGIN>/api/auth/oidc/callback.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
# Space-separated scopes. Defaults to "openid profile email" if left blank.
OIDC_SCOPES=
